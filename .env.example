# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://sport@localhost:5433/sport

# ── Redis (optional — falls back to in-memory cache/queue) ──
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=change-me-in-production

# Public site URL (SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sports data provider ─────────────────────────────────
# mock | future external provider
SPORTS_PROVIDER=mock

# ── Admin bootstrap (seed script creates this user) ───────
ADMIN_EMAIL=admin@sport.local
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin

# ── Email (dev mode logs emails to console) ───────────────
SMTP_URL=
EMAIL_FROM=no-reply@sport.local

# ── Observability ────────────────────────────────────────
LOG_LEVEL=info
